# ChurchFlow environment configuration.
# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# Supabase (required) — public-by-design anon key, NOT the service role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key


# Bible verses (required for verse lookup) — YouVersion Platform App Key.
# Get one at https://developers.youversion.com. Sent as the X-YVP-App-Key header.
# Translations are chosen by numeric version ID in code (BIBLE_IDS in src/lib/bible.ts),
# so no per-translation keys are needed. Enable the versions you use in your dashboard.
EXPO_PUBLIC_BIBLE_API_KEY=


# Error reporting (optional). When set, runtime errors and unhandled exceptions
# are forwarded to Sentry. Leave blank in development to fall through to console.
EXPO_PUBLIC_SENTRY_DSN=
# Free-form release identifier; used by Sentry to group events by build.
# Common pattern: "churchflow@${appVersion}+${gitSha}".
EXPO_PUBLIC_APP_RELEASE=
#
# Build-time only — used by the @sentry/react-native/expo plugin to upload
# source maps and debug symbols during native builds (eas build / expo run).
# NOT an EXPO_PUBLIC_ var: it must never be embedded in the client bundle.
# Set it as a local shell/CI env var or an EAS secret, never commit a real value.
# SENTRY_AUTH_TOKEN=


# ── Edge function secrets (server-side only — NOT EXPO_PUBLIC) ─────────────────
# Used by the `notify-assignment` Supabase edge function to email a volunteer
# when they're assigned to a slot. These are set on the function, not in the app
# bundle:
#   supabase secrets set SMTP_HOST=smtp.example.com SMTP_PORT=587 \
#     SMTP_USER=apikey SMTP_PASS=your-password SMTP_FROM="ChurchFlow <no-reply@yourchurch.org>"
# If unset, push notifications + the in-app banner still work; only email is skipped.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=


