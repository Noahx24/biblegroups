{
  "expo": {
    "name": "ChurchFlow",
    "slug": "biblegroups",
    "scheme": "churchflow",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#FAF6EC",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF6EC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.churchflow"
    },
    "android": {
      "package": "com.example.churchflow",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#B0202C"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "ChurchFlow needs access to your photos to let you set a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#B0202C"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "sibahle-digital"
        }
      ]
    ],
    "notification": {
      "icon": "./assets/adaptive-icon.png",
      "color": "#B0202C"
    },
    "extra": {
      "eas": {
        "projectId": "4bbdb712-7b05-45ba-ae3b-ae0ce60fb799"
      }
    }
  }
}
